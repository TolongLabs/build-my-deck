# https://github.com/github/gitignore

# JS / Bun
node_modules/
dist/
build/
*.tsbuildinfo
.vite/
.next/
test-results/
playwright-report/

# Env / secrets
.env*
!.env.example

# OS / editor
.DS_Store
__MACOSX/
Thumbs.db
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets
!*.code-workspace

# graphify: commit only the queryable graph + report; ignore regenerable churn
graphify-out/*
!graphify-out/graph.json
!graphify-out/GRAPH_REPORT.md

# Control ledger: user records and session tokens. Never commit.
data/
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
