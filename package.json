{
  "name": "build-my-deck",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "build": "bun run --filter '*' build",
    "test": "bun test --pass-with-no-tests",
    "test:e2e": "playwright test --pass-with-no-tests",
    "lint": "biome lint .",
    "format": "biome format .",
    "check": "biome check .",
    "prepare": "husky"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "hono": "^4.7.2",
    "immer": "^10.1.1",
    "nanoid": "^5.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-moveable": "^0.56.0",
    "selecto": "^1.26.3",
    "zod": "^4",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@commitlint/cli": "^19.7.1",
    "@commitlint/config-conventional": "^19.7.1",
    "@playwright/test": "^1.51.1",
    "@types/bun": "^1.2.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "axe-core": "^4.10.2",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "playwright": "^1.51.1",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  },
  "lint-staged": {
    "*.{js,json,ts,tsx}": "biome check --write"
  }
}
